+def load_funding(cfg, times, symbols):
+    """[T, N]: sum of the funding rates settled in (Open[t], Open[t] + 4h] for each bar t. A settlement at the exact
+    Open of a bar belongs to the previous bar, so a position opened at Open[t] does not pay/receive it. Symbols with no
+    settlement file (no perp yet) get NaN, which the engine treats as 0 (spot-only coins cannot be shorted anyway)."""
+    d = os.path.join(ROOT, cfg['costs']['FUNDING_DIR'])
