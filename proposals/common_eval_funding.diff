--- /dev/null	2026-10-18 18:25:01.000000000 +0700
+++ tests/test_funding.py	2026-10-18 18:24:59.491713400 +0700
@@ -0,0 +1,55 @@
+"""Funding sign tests for the proposed common_eval change (spec section 9)."""
+import copy
+import os
+import sys
+
+import numpy as np
+import pytest
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, HERE)
+import yaml
+from common_eval.backtest import Engine
+
+CFG = yaml.safe_load(open(os.path.join(HERE, 'config.yaml'), encoding='utf-8'))
+
+
+class MK:
+    def __init__(self, fund, price=100.0):
+        T = len(fund)
+        self.O = np.full((T, 1), price); self.H = self.O; self.L = self.O; self.C = np.full((T, 1), price)
+        self.fund = np.array(fund, float).reshape(-1, 1)
+        self.T, self.N = T, 1
+
+
+def test_short_receives_positive_funding_and_pays_negative():
+    e = Engine(MK([0.001, 0.001, -0.0005]), copy.deepcopy(CFG))
+    fp = e.funding_path(-1, 0, 0, 2, 'TIME')
+    assert fp == pytest.approx([0.001, 0.002, 0.0015])
+
+
+def test_long_is_not_charged_when_only_short_is_configured():
+    e = Engine(MK([0.001, 0.001, 0.001]), copy.deepcopy(CFG))
+    assert e.funding_path(1, 0, 0, 2, 'TIME') is None
+
+
+def test_long_pays_positive_funding_if_enabled():
+    c = copy.deepcopy(CFG); c['costs']['FUNDING_SIDES'] = ['long', 'short']
+    e = Engine(MK([0.001, 0.001, 0.001]), c)
+    assert e.funding_path(1, 0, 0, 2, 'TIME')[-1] == pytest.approx(-0.003)
+
+
+def test_stop_exit_skips_settlement_of_exit_bar():
+    e = Engine(MK([0.001, 0.001, 0.001]), copy.deepcopy(CFG))
+    assert e.funding_path(-1, 0, 0, 2, 'TRAIL')[-1] == pytest.approx(0.002)
+
+
+def test_funding_scales_with_price():
+    mk = MK([0.001, 0.001]); mk.C = np.array([[100.0], [50.0]])
+    e = Engine(mk, copy.deepcopy(CFG))
+    assert e.funding_path(-1, 0, 0, 1, 'TIME')[-1] == pytest.approx(0.001 + 0.001 * 0.5)
+
+
+def test_engine_off_switch_for_as_is_runs():
+    e = Engine(MK([0.001]), copy.deepcopy(CFG), funding=False)
+    assert e.funding_path(-1, 0, 0, 0, 'TIME') is None
