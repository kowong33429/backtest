+    F = np.full((len(times), len(symbols)), np.nan)
+    edges = times.values
+    for k, s in enumerate(symbols):
+        p = os.path.join(d, f'{s}.csv')
+        if not os.path.exists(p):
+            continue
+        f = pd.read_csv(p, parse_dates=['Date'])
+        f = f[(f['Date'] < cut) & (f['Date'] > times[0])]
+        b = np.searchsorted(edges, f['Date'].values, side='left') - 1      # (Open[b], Open[b+1]] -> bar b
+        ok = (b >= 0) & (b < len(times))
+        F[:, k] = 0.0
+        np.add.at(F[:, k], b[ok], f['Funding_Rate'].values[ok])
+    return F
